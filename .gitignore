# --- backend (Python) ---------------------------------------------------------
backend/.venv/
backend/data/            # local SQLite store + exports (runtime, cwd-relative)
backend/.pytest_cache/
backend/.ruff_cache/
backend/.coverage
backend/htmlcov/
backend/*.egg-info/
backend/certs/*.pem      # corporate CA certs stay local (force-add to version yours)
backend/**/__pycache__/
*.pyc
*.db
*.sqlite3
*.db-wal
*.db-shm

# backend/.env IS tracked (placeholders only); protect real values with:
#   git update-index --skip-worktree backend/.env

# --- frontend (npm) ----------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
frontend/.e2e/
frontend/*.tsbuildinfo
frontend/.e2e-api.log
frontend/.e2e-vite.log

# --- tooling / OS ------------------------------------------------------------
.superpowers/            # subagent-driven-development scratch
.playwright-mcp/
.DS_Store
.gstack/
