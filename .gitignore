# local data store and exports
data/
*.db
*.sqlite3

# python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# env — .env IS tracked (placeholders only); protect real values with:
