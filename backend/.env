# Live Phoenix connection — the offline demo needs none of this.
# After entering a real key:  git update-index --skip-worktree backend/.env
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_API_KEY=
PHEONIX_PROJECT=default
# HTTPS with an internal CA: drop the root at certs/phoenix-ca.pem, or set a path here
PHEONIX_CA_BUNDLE=
# set to false to skip TLS verification for the Phoenix connection (trusted networks only)
PHEONIX_TLS_VERIFY=true

# This tool's own API
PHEONIX_API_KEY=
PHEONIX_CORS_ORIGINS=

# Storage & skills
PHEONIX_DB_PATH=data/pheonix.db
PHEONIX_EXPORT_DIR=data/exports
PHEONIX_CAPABILITIES_DIR=capabilities
PHEONIX_SKILLS_CATALOG=config/skills_catalog.yaml
PHEONIX_SKILLS_DIRS=

# Tuning knobs (timeouts, eval thresholds, ladder bars, history limit) all have
# sensible defaults — see .env.example for the full list and what each does.
