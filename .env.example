# --- Live Phoenix mode (optional; offline fixture mode works without these) ---
# Self-hosted Phoenix endpoint, e.g. http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=
# System API key issued from Phoenix UI (Settings > API Keys)
PHOENIX_API_KEY=

# --- TLS to Phoenix (only for HTTPS endpoints with an internal/corporate CA) ---
# Preferred: just drop the corporate root CA at certs/phoenix-ca.pem — it is
# picked up automatically and this can stay empty. Set a path only to use a
# different location.
PHEONIX_CA_BUNDLE=
# Last resort on a trusted internal network: set to false to disable
# certificate verification for the Phoenix connection.
PHEONIX_TLS_VERIFY=true

# --- Scraper settings (all optional, sensible defaults) ---
# Inbound auth for THIS tool's API (distinct from PHOENIX_API_KEY above, which is
# outbound to Phoenix). When set, every route except /health requires the
# X-API-Key header. Required to serve on a non-loopback host.
PHEONIX_API_KEY=
# Phoenix project to scrape
PHEONIX_PROJECT=default
# Local store location
PHEONIX_DB_PATH=data/pheonix.db
PHEONIX_EXPORT_DIR=data/exports
# Skills catalog YAML and/or directories containing SKILL.md files (comma-separated)
PHEONIX_SKILLS_CATALOG=config/skills_catalog.yaml
PHEONIX_SKILLS_DIRS=
