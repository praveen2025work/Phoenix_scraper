# --- Live Phoenix mode (optional; offline fixture mode works without these) ---
# Self-hosted Phoenix endpoint, e.g. http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=
# System API key issued from Phoenix UI (Settings > API Keys)
PHOENIX_API_KEY=

# --- TLS to Phoenix (only for HTTPS endpoints with an internal/corporate CA) ---
# Preferred: just drop the corporate root CA at certs/phoenix-ca.pem — it is
# picked up automatically and this can stay empty. Set a path only to use a
# different location.
PHEONIX_CA_BUNDLE=
# Last resort on a trusted internal network: set to false to disable
# certificate verification for the Phoenix connection.
PHEONIX_TLS_VERIFY=true

# --- Scraper settings (all optional, sensible defaults) ---
# Inbound auth for THIS tool's API (distinct from PHOENIX_API_KEY above, which is
# outbound to Phoenix). When set, every route except /health requires the
# X-API-Key header. Required to serve on a non-loopback host.
PHEONIX_API_KEY=
# Phoenix project to scrape (name or id from https://<phoenix-host>/v1/projects)
PHEONIX_PROJECT=default
# Read timeout (seconds) for Phoenix API calls. The FIRST scrape scans the whole
# project history and can need far more than the 30s default on large projects —
# raise to e.g. 180 if scrape fails with read timeouts.
PHEONIX_HTTP_TIMEOUT=30
# Max spans pulled per scrape cycle; lower it (e.g. 1000) to make each request
# cheaper on a slow server, then just run `pheonix scrape` repeatedly.
PHEONIX_SCRAPE_LIMIT=5000
# Local store location
PHEONIX_DB_PATH=data/pheonix.db
PHEONIX_EXPORT_DIR=data/exports
# Skills catalog YAML and/or directories containing SKILL.md files (comma-separated)
PHEONIX_SKILLS_CATALOG=config/skills_catalog.yaml
PHEONIX_SKILLS_DIRS=

# --- Validation (code checks over LLM outputs and user prompts) ---
# Run the checks as part of `pheonix analyze`; `pheonix evaluate` runs them either way.
PHEONIX_EVALUATE_ON_ANALYZE=true
# Share of the question's content words an answer must echo for full relevance
# credit. Low on purpose — lexical overlap only reliably catches answers that
# share almost nothing with the question. Raising it flags good short answers.
PHEONIX_EVAL_RELEVANCE_OVERLAP=0.15
# Minimum distinct-word ratio before an answer reads as degenerate repetition.
PHEONIX_EVAL_REPETITION_THRESHOLD=0.35
# Latency / prompt-length outlier cut: the quantile, and the multiple of the
# median a value must ALSO exceed (so a consistent agent produces no outliers).
PHEONIX_EVAL_OUTLIER_QUANTILE=0.95
PHEONIX_EVAL_OUTLIER_FACTOR=2.0
# Span ids per Phoenix annotation request when pulling/pushing annotations.
PHEONIX_ANNOTATION_BATCH_SIZE=100

# --- Skill coverage (what each skill FILE is asked but doesn't demonstrate) ---
# A cluster matched to a skill counts as already covered when it resembles one
# of that skill's own example_prompts this closely. Lower it to report fewer
# gaps, raise it to demand closer examples.
PHEONIX_SKILL_COVERAGE_THRESHOLD=0.70
# Max example_prompts suggested per skill per run.
PHEONIX_MAX_SUGGESTED_PROMPTS=8
# Analysis runs kept for run-over-run diffing ("what's new since last week").
PHEONIX_RUN_HISTORY_LIMIT=20
